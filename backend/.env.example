# Primary: gemini or openrouter. Auto uses the other configured key as backup.
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Leave blank to keep the database at backend/asklearn.db.
DATABASE_URL=
MAX_UPLOAD_MB=15
MAX_TEXT_CHARS=500000
COOKIE_SECURE=false
# Set only for an HTTPS deployment; local development uses the request origin.
PUBLIC_ORIGIN=
CLOUD_PILOT=false
